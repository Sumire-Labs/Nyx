{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    ":dependencyDashboard"
  ],
  "timezone": "Asia/Tokyo",
  "schedule": [
    "before 6am on monday"
  ],
  "labels": [
    "dependencies"
  ],
  "automerge": false,
  "platformAutomerge": false,
  "packageRules": [
    {
      "description": "Go modules",
      "matchManagers": ["gomod"],
      "rangeStrategy": "bump",
      "automerge": false
    },
    {
      "description": "GitHub Actions",
      "matchManagers": ["github-actions"],
      "automerge": false
    },
    {
      "description": "メジャーバージョンアップデート",
      "matchUpdateTypes": ["major"],
      "addLabels": ["major-update"]
    },
    {
      "description": "マイナー・パッチアップデート",
      "matchUpdateTypes": ["minor", "patch"],
      "addLabels": ["minor-patch-update"]
    },
    {
      "description": "セキュリティアップデート",
      "matchDatasources": ["go"],
      "addLabels": ["security"],
      "prPriority": 10
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security", "vulnerability"],
    "prCreation": "immediate",
    "automerge": false
  },
  "prConcurrentLimit": 5,
  "prHourlyLimit": 3,
  "commitMessagePrefix": "chore(deps):",
  "commitMessageAction": "update",
  "commitMessageExtra": "to {{newVersion}}",
  "prTitle": "{{commitMessagePrefix}} {{commitMessageAction}} {{depName}} {{commitMessageExtra}}",
  "prBodyTemplate": "この PR は {{depName}} を {{currentVersion}} から {{newVersion}} にアップデートします。\n\n{{#if releases}}\n## リリースノート\n\n{{#each releases}}\n### {{title}}\n{{#if body}}\n{{body}}\n{{/if}}\n{{/each}}\n{{/if}}\n\n---\n\n🔄 **依存関係アップデート**  \n📅 **スケジュール**: 毎週月曜日  \n🏷️ **ブランチ**: {{branchName}}  \n🤖 **Renovate Bot**: 依存関係を最新状態に保ちます",
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "🔄 Dependency Dashboard",
  "dependencyDashboardHeader": "このダッシュボードは依存関係のアップデート状況を表示します。\n\n📋 **すべて手動マージ**: PRは自動作成されますが、マージは手動で行ってください",
  "gitAuthor": "renovate[bot] <29139614+renovate[bot]@users.noreply.github.com>"
}